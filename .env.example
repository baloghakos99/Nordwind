# Copy to .env and fill in. Never commit .env.

OPENROUTER_API_KEY=
# Cheap fallback when rules fail — only called for failed validations
OPENROUTER_MODEL=openai/gpt-4o-mini
# Parallel invoice jobs (rules + LLM + FX). Caps OpenRouter fan-out. Default 3, max 16.
LLM_CONCURRENCY=3

PORT=8080
DATA_DIR=./data
